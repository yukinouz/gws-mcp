{
  "permissions": {
    "deny": [
      "Read(~/.config/gws-mcp/**)",
      "Edit(~/.config/gws-mcp/**)",
      "Read(**/credentials.json)",
      "Edit(**/credentials.json)",
      "Read(**/token.json)",
      "Edit(**/token.json)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/block-gws-secrets.sh"
          }
        ]
      }
    ]
  }
}
